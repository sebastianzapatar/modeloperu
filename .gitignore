# Vensim run files and per-worker scratch folders.
*.vdfx
*.vdf
*.dat
_work*/
results/peru/_model/

# Scratch output from diagnostics, probes and short test sweeps.
/results/_*

# The 3-factor published model: superseded by ModeloCh4_Sens2.vpmx, and 40 MB.
# README section 6 says how to republish it from ModeloCh4_Sens.mdl, which is
# tracked, if the archived three-factor study ever has to be re-derived.
model/ModeloCh4_Sens.vpmx

# Sweep logs
logs/
*.log
*.out
~$*

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# LaTeX build artefacts. The PDFs are kept (they are the deliverable); everything
# latexmk regenerates is not.
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.fdb_latexmk
paper/latex/*.fls
paper/latex/*.log
paper/latex/*.out
paper/latex/*.toc
paper/latex/*.spl
paper/latex/*.synctex.gz
paper/latex/_out/
