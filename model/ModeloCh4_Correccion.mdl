	Max(
	Max(
	VMAX(Offer Price[Thermo1!]),
	VMAX(Offer Price[Thermo2!])),
	Max(
	VMAX(Offer Price[Biomass!]),
	VMAX(Offer Price[Geothermal!]))
	)
