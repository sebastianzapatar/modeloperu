Third Interconnection Adjusted Imbalance[ForecastYear,Hour,Int,Zone]=
	IF THEN ELSE(
	Sum(Fourth Imbalance by Zone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases[Int\
		,Zone!])<1:AND:
	Sum(Fourth Imbalance by Zone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases[Int\
		,Zone!])>-1,
	IF THEN ELSE( 
	VMAX(Fourth Imbalance by Zone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases[Int\
		,Zone!])<=0.005:AND:
	VMAX(Fourth Imbalance by Zone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases[Int\
		,Zone!])>=-0.005 ,0 ,1 ),0)*Fourth Imbalance by Zone[ForecastYear,Hour,Zone]*Interconnection Pairs Cases\
		[Int,Zone]
	~	MW
	~		|

