	-Available Interconnection Flow by Int[ForecastYear,Hour,Int6]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int6], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int7]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int7], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int8]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int8], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z6]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int5]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int5], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int12]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int12], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int14], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int15]*IF THEN ELSE(Max Priority Rank\
		[Int9]<Max Priority Rank[Int15], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int10]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z4]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0,
	Surplus by Zone[ForecastYear,Hour,Z3]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int2]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int2], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int6]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int6], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int11]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int11], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int12]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int12], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z4]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int3]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int3], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int7]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int7], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int13]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int13], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int10]<Max Priority Rank[Int14], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int11]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z5]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0,
	Surplus by Zone[ForecastYear,Hour,Z3]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int2]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int2], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int6]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int6], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int10]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int10], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int12]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int12], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z5]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int4]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int4], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int8]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int8], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int13]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int13], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int15]*IF THEN ELSE(Max Priority Rank\
		[Int11]<Max Priority Rank[Int15], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int12]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z6]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0,
	Surplus by Zone[ForecastYear,Hour,Z3]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int2]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int2], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int6]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int6], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int10]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int10], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int11]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int11], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z6]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int5]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int5], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int9]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int9], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int14], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int15]*IF THEN ELSE(Max Priority Rank\
		[Int12]<Max Priority Rank[Int15], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int13]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z5]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]>0,
	Surplus by Zone[ForecastYear,Hour,Z4]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int3]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int3], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int7]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int7], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int10]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int10], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int14], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z5]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int4]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int4], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int8]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int8], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int11]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int11], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int15]*IF THEN ELSE(Max Priority Rank\
		[Int13]<Max Priority Rank[Int15], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int14]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z6]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]>0,
	Surplus by Zone[ForecastYear,Hour,Z4]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int3]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int3], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int7]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int7], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int10]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int10], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int14], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z6]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int5]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int5], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int9]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int9], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int12]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int12], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int15]*IF THEN ELSE(Max Priority Rank\
		[Int14]<Max Priority Rank[Int15], 0 , 1 ))) ~~|
Surplus without Allocation[ForecastYear,Hour,Int15]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z5]=0:AND:Surplus by Zone[ForecastYear\
		,Hour,Z6]=0, 0, 
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z5]>0,
	Surplus by Zone[ForecastYear,Hour,Z5]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int4]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int4], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int8]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int8], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int11]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int11], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int13]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int13], 0 , 1 ),
	Surplus by Zone[ForecastYear,Hour,Z6]
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int5]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int5], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int9]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int9], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int12]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int12], 0 , 1 )
	-Available Interconnection Flow by Int[ForecastYear,Hour,Int14]*IF THEN ELSE(Max Priority Rank\
		[Int15]<Max Priority Rank[Int14], 0 , 1 )))
	~	MWh
	~		|

Effective Allocation Limit[ForecastYear,Hour,Int1]=
	Max(
	Min(
	Min(Surplus without Allocation[ForecastYear,Hour,Int1],Available Interconnection Flow by Int\
		[ForecastYear,Hour,Int1]),
	Deficit without Allocation[ForecastYear,Hour,Int1]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int2]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int2],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int2]),Deficit without Allocation\
		[ForecastYear,Hour,Int2]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int3]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int3],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int3]),Deficit without Allocation\
		[ForecastYear,Hour,Int3]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int4]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int4],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int4]),Deficit without Allocation\
		[ForecastYear,Hour,Int4]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int5]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int5],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int5]),Deficit without Allocation\
		[ForecastYear,Hour,Int5]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int6]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int6],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int6]),Deficit without Allocation\
		[ForecastYear,Hour,Int6]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int7]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int7],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int7]),Deficit without Allocation\
		[ForecastYear,Hour,Int7]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int8]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int8],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int8]),Deficit without Allocation\
		[ForecastYear,Hour,Int8]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int9]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int9],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int9]),Deficit without Allocation\
		[ForecastYear,Hour,Int9]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int10]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int10],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int10]),Deficit without Allocation\
		[ForecastYear,Hour,Int10]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int11]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int11],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int11]),Deficit without Allocation\
		[ForecastYear,Hour,Int11]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int12]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int12],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int12]),Deficit without Allocation\
		[ForecastYear,Hour,Int12]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int13]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int13],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int13]),Deficit without Allocation\
		[ForecastYear,Hour,Int13]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int14]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int14],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int14]),Deficit without Allocation\
		[ForecastYear,Hour,Int14]),0) ~~|
Effective Allocation Limit[ForecastYear,Hour,Int15]=
	Max(Min(Min(Surplus without Allocation[ForecastYear,Hour,Int15],
	Available Interconnection Flow by Int[ForecastYear,Hour,Int15]),Deficit without Allocation\
		[ForecastYear,Hour,Int15]),0)
	~	MWh
	~		|

Mean Length by Int[Int]=
	GET XLS CONSTANTS('?Datos','Interconnections','O3*' )
	~	km
	~		|

Second Surplus by IntZone Condition[ForecastYear,Hour,Int,Zone]=
	IF THEN ELSE(
	(Second Imbalance by Zone[ForecastYear,Hour,Zone]*Interconnection Pairs Cases[Int,Zone\
		])>0, 1 ,0 )
	~	
	~		|

Interconnection Flow Sum per Zone[ForecastYear,Hour,Zone]=
	Sum(Interconnection Flow[ForecastYear,Hour,Int!,Zone])
	~	MWh
	~		|

Fourth Imbalance by Zone[ForecastYear,Hour,Zone]=
	Third Imbalance by Zone[ForecastYear,Hour,Zone]+Third Interconnection Flow Sum per Zone\
		[ForecastYear,Hour,Zone]*-1
	~	MWh
	~		|

Interconnection Second Match Condition[ForecastYear,Hour,Int]=
	Sum(Second Deficit by IntZone Condition[ForecastYear,Hour,Int,Zone!])*Sum(Second Surplus by IntZone Condition\
		[ForecastYear,Hour,Int,Zone!])
	~	Dmnl
	~		|

Deficit per IntZone[ForecastYear,Hour,Int,Zone]=
	Interconnection Pairs Cases[Int,Zone]*Deficit by Zone[ForecastYear,Hour,Zone]
	~	MWh
	~		|

Positive Interconnection Flow Sum by Zone[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Interconnection Flow Sum per Zone[ForecastYear,Hour,Zone]<0,Interconnection Flow Sum per Zone\
		[ForecastYear,Hour,Zone]*-1,0)
	~	MWh
	~		|

New IntZone Capacity Availability[ForecastYear,Hour,Int,Zone]=
	(Min Interconnection Capacity[ForecastYear,Int]+Interconnection Flow[ForecastYear,Hour\
		,Int,Zone]*Destination Deficit per Zone Condition
	[ForecastYear,Hour,Zone]*-1)*IntZone Pairs Cases Condition
	[ForecastYear,Hour,Int,Zone]
	~	MW
	~		|

Destination Deficit by IntZone Redispatch Condition[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Second Imbalance by Zone[ForecastYear,Hour,Zone]>0,-1,1)
	~	Dmnl
	~		|

Destination Deficit per Zone Condition[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Sum(Destination Deficit per IntZone[ForecastYear,Hour,Int!,Zone])>1,-1,\
		1)
	~	Dmnl
	~		|

Percentage of energy allocated[ForecastYear,Hour]=
	IF THEN ELSE(Sum(Positive Imbalance by Zone[ForecastYear,Hour,Zone!])=0,0, Sum(Positive Interconnection Flow Sum by Zone\
		[ForecastYear,Hour,Zone!])/Sum(Positive Imbalance by Zone[ForecastYear,Hour,Zone
	!]))
	~	
	~		|

Surplus per IntZone[ForecastYear,Hour,Int,Zone]=
	Interconnection Pairs Cases[Int,Zone]*Surplus by Zone[ForecastYear,Hour,Zone]
	~	MWh
	~		|

Allowed Second Interconnection Flow[ForecastYear,Hour,Int,Zone]=
	Max(Min(Second Interconnection Capacity Availability[ForecastYear,Hour,Int],Second Imbalance by Zone\
		[ForecastYear,Hour,Zone
	]*Interconnection Pairs Cases
	[Int,Zone])*Interconnection Second Match Condition
	[ForecastYear,Hour,Int],Min(Second Interconnection Capacity Availability[ForecastYear\
		,Hour,Int],Second Imbalance by Zone
	[ForecastYear,Hour,Zone]*Interconnection Pairs Cases
	[Int,Zone])*Interconnection Second Match Condition
	[ForecastYear,Hour,Int])
	~	MWh
	~		|

Allowed Third Interconnection Flow[ForecastYear,Hour,Int,Zone]=
	Third Imbalance by Zone[ForecastYear,Hour,Zone]*Interconnection Third Match Review[ForecastYear\
		,Hour,Int,Zone]*Interconnection Pairs Cases
	[Int,Zone]*-1
	~	MWh
	~		|

Interconnection Match Condition[ForecastYear,Hour,Int]=
	IF THEN ELSE( Interconnection Surplus Condition[ForecastYear,Hour,Int]>0:AND:Interconnection Deficit Condition\
		[ForecastYear,Hour,Int]>0 , 1 , 0 )
	~	MWh
	~		|

Interconnection Match Value Int[ForecastYear,Hour,Int]=
	Interconnection Deficit Value[ForecastYear,Hour,Int]
	      * IF THEN ELSE(Interconnection Match Condition[ForecastYear,Hour,Int] = 1 
	       :AND: Interconnection Surplus Value[ForecastYear,Hour,Int] > 0,
	          1,
	          0
	        )
	~	MWh
	~		|

Percentage of Second Energy Allocated[ForecastYear,Hour]=
	1-IF THEN ELSE(Sum(Positive Imbalance by Zone[ForecastYear,Hour,Zone
	!])=0,0,Sum(Second Net Imbalance by Zone[ForecastYear,Hour,Zone!])/Sum(Positive Imbalance by Zone\
		[ForecastYear,Hour,Zone!
	]))
	~	Dmnl
	~		|

Interconnection Surplus Condition[ForecastYear,Hour,Int]=
	IF THEN ELSE(Sum(Surplus per IntZone[ForecastYear,Hour,Int,Zone!])>0,1,0)
	~	MWh
	~		|

Third Deficit by IntZone[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Third Imbalance by Zone[ForecastYear,Hour,Zone]<-0.01,1,0)
	~	Dmnl
	~		|

Capacity by interconnection[Int]=
	GET XLS CONSTANTS('?Datos','Interconnections','R3*' )
	~	MW
	~		|

Third Interconnection Capacity Availability[ForecastYear,Hour,Int]=
	Min Interconnection Capacity[ForecastYear,Int]
	-VMAX(Interconnection Flow[ForecastYear,Hour,Int,Zone!])
	-VMAX(Second Interconnection Flow[ForecastYear,Hour,Int,Zone!])
	~	MW
	~		|

Third Interconnection Flow Sum per Zone[ForecastYear,Hour,Zone]=
	Sum(Third Interconnection Flow[ForecastYear,Hour,Int!,Zone]*Interconnection Pairs Cases\
		[Int!,Zone])
	~	MWh
	~		|

Second Deficit by IntZone Condition[ForecastYear,Hour,Int,Zone]=
	IF THEN ELSE((Second Imbalance by Zone[ForecastYear,Hour,Zone]*Interconnection Pairs Cases\
		[Int,Zone])<0, 1 ,0 )
	~	Dmnl
	~		|

Jumps by Interconnection[Int]=
	GET XLS CONSTANTS('?Datos','Interconnections','U3*' )
	~	Dmnl
	~		|

Percentage of Third Energy Allocated[ForecastYear,Hour]=
	1-IF THEN ELSE(Sum(Positive Imbalance by Zone[ForecastYear,Hour,Zone
	!])=0,0,Sum(Third Net Imbalance by Zone[ForecastYear,Hour,Zone!])/Sum(Positive Imbalance by Zone\
		[ForecastYear,Hour,Zone!
	]))
	~	Dmnl
	~		|

Second Interconnection Flow[ForecastYear,Hour,Int,Zone]=
	Min(VMAX(Allowed Second Interconnection Flow[ForecastYear,Hour,Int,Zone!]),vmin(Allowed Second Interconnection Flow\
		[ForecastYear
	,Hour,Int,Zone!])*-1)*Destination Deficit by IntZone Redispatch Condition
	[ForecastYear,Hour,Zone]*Interconnection Pairs Cases[Int,Zone]
	~	MWh
	~		|

Interconnection Deficit Condition[ForecastYear,Hour,Int]=
	IF THEN ELSE( Sum(Deficit per IntZone[ForecastYear,Hour,Int,Zone!])>0,1,0 )
	~	MWh
	~		|

Interconnection Deficit Value[ForecastYear,Hour,Int]=
	Sum(Deficit per IntZone[ForecastYear,Hour,Int,Zone!]*IF THEN ELSE(Interconnection Pairs Cases\
		[Int,Zone!]>0:AND:Interconnection Match Condition
	[ForecastYear,Hour,Int]>0, 1 , 0 ))
	~	MWh
	~		|

Interconnection Flow[ForecastYear,Hour,Int,Zone]=
	Effective Allocation Limit[ForecastYear,Hour,Int]*Destination Deficit per Zone Condition\
		[ForecastYear,Hour,Zone]*Interconnection Pairs Cases
	[Int,Zone]
	~	MWh
	~		|

Positive Third Imbalance by Zone[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Third Imbalance by Zone[ForecastYear,Hour,Zone]<0,0 ,Third Imbalance by Zone\
		[ForecastYear,Hour,
	Zone] )
	~	MWh
	~		|

Interconnection Surplus Value[ForecastYear,Hour,Int]=
	Sum(Surplus per IntZone[ForecastYear,Hour,Int,Zone!]*IF THEN ELSE(Interconnection Pairs Cases\
		[Int,Zone!]>0:AND:Interconnection Match Condition
	[ForecastYear,Hour,Int]>0, 1 , 0 ))
	~	MWh
	~		|

Third Net Imbalance by Zone[ForecastYear,Hour,Zone]=
	Positive Fourth Imbalance by Zone[ForecastYear,Hour,Zone]-Imbalance by Zone[ForecastYear\
		,Hour,Zone]
	~	MWh
	~		|

Second Imbalance by Zone[ForecastYear,Hour,Zone]=
	Imbalance by Zone[ForecastYear,Hour,Zone]+Interconnection Flow Sum per Zone[ForecastYear\
		,Hour,Zone]*-1
	~	MWh
	~		|

Km by Interconnection[Int]=
	GET XLS CONSTANTS('?Datos','Interconnections','Q3*' )
	~	km
	~		|

Second Interconnection Capacity Availability[ForecastYear,Hour,Int]=
	VMAX(New IntZone Capacity Availability[ForecastYear,Hour,Int,Zone!])
	~	MW
	~		|

Interconnection Third Match Condition[ForecastYear,Hour,Int]=
	Sum(Third Deficit by IntZone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases[Int\
		,Zone!])*Sum(Third Surplus by IntZone[ForecastYear,Hour,Zone!]*Interconnection Pairs Cases\
		[Int,Zone!])
	~	Dmnl
	~		|

Interconnection Third Match Review[ForecastYear,Hour,Int,Zone]=
	Interconnection Third Match Condition[ForecastYear,Hour,Int]*Interconnection Pairs Cases\
		[Int,Zone]
	~	Dmnl
	~		|

Destination Deficit per IntZone[ForecastYear,Hour,Int,Zone]=
	IF THEN ELSE(Deficit per IntZone[ForecastYear,Hour,Int,Zone]>1 , Interconnection Match Value Int\
		[ForecastYear,Hour,Int], 0)
	~	MWh
	~		|

Max Line Prioritization by IntZone[Int,Zone]=
	VMAX(Line Prioritization by Zone[Int!,Zone])*VMAX(Line Prioritization by Zone[Int,Zone\
		!])
	~	
	~		|

Line Prioritization Index[Int]=
	IF THEN ELSE( Km by Interconnection[Int]=0:OR:Capacity by interconnection[Int]=0 , 0\
		 ,
	((Capacity by interconnection[Int]-vmin(Capacity by interconnection[Int!]))/(VMAX(Capacity by interconnection\
		[Int!])
	-vmin(Capacity by interconnection[Int!])))/
	((Km by Interconnection[Int]-vmin(Km by Interconnection[Int!]))/(VMAX(Km by Interconnection
	[Int!])-vmin(Km by Interconnection
	[Int!])))^1/Jumps by Interconnection[Int]
	)
	~	Dmnl
	~		|

Third Surplus by IntZone[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Third Imbalance by Zone[ForecastYear,Hour,Zone]>0.01, 1,0)
	~	Dmnl
	~		|

Max Line Prioritization by Int[Int]=
	Sum(Max Line Prioritization by IntZone[Int,Zone!])
	~	Dmnl
	~		|

Positive Fourth Imbalance by Zone[ForecastYear,Hour,Zone]=
	IF THEN ELSE(Fourth Imbalance by Zone[ForecastYear,Hour,Zone]<0,0 ,Fourth Imbalance by Zone\
		[ForecastYear,Hour,Zone])
	~	MWh
	~		|

Line Prioritization by Zone[Int,Zone]=
	Line Prioritization Index[Int]*Interconnection Pairs Cases[Int,Zone]
	~	Dmnl
	~		|

Second Interconnection Flow Sum per Zone[ForecastYear,Hour,Zone]=
	Sum(Second Interconnection Flow[ForecastYear,Hour,Int!,Zone])*-1
	~	MWh
	~		|

IntZone Pairs Cases Condition[ForecastYear,Hour,Int,Zone]=
	IF THEN ELSE(Deficit per IntZone[ForecastYear,Hour,Int,Zone]:OR:Surplus per IntZone[\
		ForecastYear,Hour,Int,Zone]>1 , 1, 0)
	~	Dmnl
	~		|

Third Imbalance by Zone[ForecastYear,Hour,Zone]=
	Second Imbalance by Zone[ForecastYear,Hour,Zone]+Second Interconnection Flow Sum per Zone\
		[ForecastYear,Hour,Zone]*-1
	~	MWh
	~		|

Second Net Imbalance by Zone[ForecastYear,Hour,Zone]=
	Positive Third Imbalance by Zone[ForecastYear,Hour,Zone]-Imbalance by Zone[ForecastYear\
		,Hour,Zone]
	~	MWh
	~		|

Positive Imbalance by Zone[ForecastYear,Hour,Zone]=
	IF THEN ELSE( Imbalance by Zone[ForecastYear,Hour,Zone]<0 ,0 , Imbalance by Zone
	[ForecastYear,Hour,Zone])
	~	MWh
	~		|

Generation Capacity Cost by Tech[ZTech]=
	Generation Capacity[ZTech]*Capital Generation Cost[ZTech]+Total DER Capacity*Capital Generation Cost\
		[Z1PV]
	~	USD
	~		|

Desired Projects for Margin[ZTech]=
	IF THEN ELSE(
	VMAX(Accumulated Generation Delays[ZTech!])>0:OR:Generation Forecasting Switch=1,
	New Capacity Allocation by Tech[f7,ZTech]*(1-Endogenous Margin Generation Switch),
	New Capacity Allocation by Tech[f1,ZTech]*(1-Endogenous Margin Generation Switch))*Switch Margin Investments
	+
	IF THEN ELSE(
	VMAX(Accumulated Generation Delays[ZTech!])>0:OR:Generation Forecasting Switch=1,
	Power Availability Allocation NPV[f7,ZTech]*(1-Endogenous Margin Generation Switch),
	Power Availability Allocation NPV[f1,ZTech]*(1-Endogenous Margin Generation Switch))\
		*(1-Switch Margin Investments)
	~	MW
	~	Min((IF THEN ELSE(MODULO(Time,1)=0,
		Max(New Capacity Allocation by Tech[ZTech],New Capacity Allocation by Tech in 5 \
		years[ZTech]),0)
		/TIME STEP)
		*(1-Endogenous Margin Generation Switch),
		Potential Generation Expansion[ZTech])
	|

Switch Margin Investments=
	GET XLS CONSTANTS('?Datos', 'General Parameters', 'B16')
	~	Dmnl
	~		|

Switch GETs=
	GET XLS CONSTANTS('?Datos','General Parameters','B22' )
	~	Dmnl
	~		|

Switch BESS=
	GET XLS CONSTANTS('?Datos','General Parameters','B23' )
	~	Dmnl
	~		|

