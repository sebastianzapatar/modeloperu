		[Hour,Z6Geothermal
	])) ~~|
Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,Z6PVBESSOp1]=
	IF THEN ELSE(Ideal Dispatch with New Capacity[ForecastYear,TPVBESSOp1,Z6,Hour,Z6PVBESSOp1\
		]=0, 0,
	Ideal Dispatch with New Capacity[ForecastYear,TPVBESSOp1,Z6,Hour,Z6PVBESSOp1]
	/
	(Generation with New Projects[ForecastYear,TPVBESSOp1,Z6,Hour,Z6PVBESSOp1]/Total Adjusted Availability Factor\
		[Hour,Z6PVBESSOp1
	])) ~~|
Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,Z6PVBESSOp2]=
	IF THEN ELSE(Ideal Dispatch with New Capacity[ForecastYear,TPVBESSOp2,Z6,Hour,Z6PVBESSOp2\
		]=0, 0,
	Ideal Dispatch with New Capacity[ForecastYear,TPVBESSOp2,Z6,Hour,Z6PVBESSOp2]
	/
	(Generation with New Projects[ForecastYear,TPVBESSOp2,Z6,Hour,Z6PVBESSOp2]/Total Adjusted Availability Factor\
		[Hour,Z6PVBESSOp2
	])) ~~|
Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,Z6Other1]=
	IF THEN ELSE(Ideal Dispatch with New Capacity[ForecastYear,TOther1,Z6,Hour,Z6Other1]\
		=0, 0,
	Ideal Dispatch with New Capacity[ForecastYear,TOther1,Z6,Hour,Z6Other1]
	/
	(Generation with New Projects[ForecastYear,TOther1,Z6,Hour,Z6Other1]/Total Adjusted Availability Factor\
		[Hour,Z6Other1])) ~~|
Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,Z6Other2]=
	IF THEN ELSE(Ideal Dispatch with New Capacity[ForecastYear,TOther2,Z6,Hour,Z6Other2]\
		=0, 0,
	Ideal Dispatch with New Capacity[ForecastYear,TOther2,Z6,Hour,Z6Other2]
	/
	(Generation with New Projects[ForecastYear,TOther2,Z6,Hour,Z6Other2]/Total Adjusted Availability Factor\
		[Hour,Z6Other2])) ~~|
Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,Z6Other3]=
	IF THEN ELSE(Ideal Dispatch with New Capacity[ForecastYear,TOther3,Z6,Hour,Z6Other3]\
		=0, 0,
	Ideal Dispatch with New Capacity[ForecastYear,TOther3,Z6,Hour,Z6Other3]
	/
	(Generation with New Projects[ForecastYear,TOther3,Z6,Hour,Z6Other3]/Total Adjusted Availability Factor\
		[Hour,Z6Other3]))
	~	Dmnl
	~		|

Residual Hour Ranking[ForecastYear,Hour]=
	VECTOR RANK(Max demand in Night Hours[ForecastYear,Hour],0)
	~	Dmnl
	~		|

New Investment Decisions[ZTech]=
	(IF THEN ELSE(MODULO(Time,1)=0, Desired Projects for Margin[ZTech]/TIME STEP, 0 )*(1\
		-Other Generation Switch) )
	~	MW/Month
	~	(IF THEN ELSE(MODULO(Time,1)=0, Desired Projects for Margin[ZTech], 0 \
		)*(1-Other Generation Switch) )*(1-Other Generation Switch)
	|

Congested Dispatch Price with New Projects[ForecastYear,Hour,Zone,ZTech]=
	Isolated Dispatch Price with New Projects[ForecastYear,Hour,ZTech]+
	IF THEN ELSE(
	Sum(Expected Interconnection Capacity[ForecastYear,Int!]*Interconnection Pairs Cases\
		[Int!,Zone])= 0,
	0,
	(IF THEN ELSE(Sum(Max Interconnection Capacity Vensim[ForecastYear,Int!]*Interconnection Pairs Cases\
		[Int!,Zone])=0,0,(Min(Sum(Expected Interconnection Capacity[ForecastYear,Int!]*Interconnection Pairs Cases\
		[Int!,Zone]),
	Sum(Max Interconnection Capacity Vensim[ForecastYear,Int!]*Interconnection Pairs Cases\
		[Int!,Zone]))
	/Sum(Max Interconnection Capacity Vensim[ForecastYear,Int!]*Interconnection Pairs Cases\
		[Int!,Zone])))
	
	*((Ideal Dispatch Price with New Projects[ForecastYear,Hour,ZTech]-Isolated Dispatch Price with New Projects\
		[ForecastYear
	,Hour,ZTech])
	)
	))
	~	USD/MWh
	~		|

Expected Hourly Generation[ForecastYear,ZTech,Hour]=
	Generation Factor Ideal Dispatch with New Projects[ForecastYear,Hour,ZTech]*Size of Investment\
		[ZTech]
	~	MWh
	~		|

Ideal Dispatch Price Expected[ForecastYear,Hour,Z1Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z1Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z1,Z1Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation ) ~~|
Ideal Dispatch Price Expected[ForecastYear,Hour,Z2Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z2Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z2,Z2Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation ) ~~|
Ideal Dispatch Price Expected[ForecastYear,Hour,Z3Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z3Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z3,Z3Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation ) ~~|
Ideal Dispatch Price Expected[ForecastYear,Hour,Z4Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z4Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z4,Z4Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation ) ~~|
Ideal Dispatch Price Expected[ForecastYear,Hour,Z5Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z5Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z5,Z5Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation ) ~~|
Ideal Dispatch Price Expected[ForecastYear,Hour,Z6Tech]=
	SMOOTH(
	Ideal Dispatch Price with New Projects[ForecastYear,Hour,Z6Tech]*(1-"Zonal Prices?")
	+Congested Dispatch Price with New Projects[ForecastYear,Hour,Z6,Z6Tech]*"Zonal Prices?"\
		, 
	Time to Form Price Expectation )
	~	USD/MWh
	~		|

Ideal Dispatch Price with New Projects[ForecastYear,Hour,ZTech]=
	VMAX(Adjusted Offer Price Ideal Dispatch with New Projects[ForecastYear,Hour,ZTech!]\
		)
	~	USD/MWh
	~		|

Ideal Dispatch with New Capacity[ForecastYear,TechDER,Zone,Hour,ZTech]=
	ALLOCATE BY PRIORITY(Generation with New Projects[ForecastYear,TechDER,Zone,Hour,ZTech\
		], Dispatch Priority[ZTech], ELMCOUNT(ZTech),Width
	,Residual Demand by zone[f0,Hour,Zone])
	~	MWh
	~		|

Profitable Energy Technologies[ZTech]=
	IF THEN ELSE(EXP(Negative NPV Tecnologies[ZTech]/1e+08)=1, 0 , 
	IF THEN ELSE(Sum(EXP(Negative NPV Tecnologies[ZTech!]/1e+08))=0,0,EXP(Negative NPV Tecnologies\
		[ZTech]/1e+08)/Sum(EXP(Negative NPV Tecnologies
	[ZTech!]/1e+08))))
	~	Dmnl
	~		|

Energy Availability Allocation by Size Tech[ForecastYear]=
	IF THEN ELSE(Sum(Daily Availability by Tech[ZTech!])>0:AND:Total Daily Extra Availability Need\
		[ForecastYear]>0,1,0)
	~	MWh
	~		|

Net Avalaibility Need[ForecastYear]=
	IF THEN ELSE(Power Allocation[ForecastYear]=0:AND:Energy Availability Allocation by Size Tech\
		[ForecastYear]=0,0,
	IF THEN ELSE(Power Allocation[ForecastYear]=0:AND:Energy Availability Allocation by Size Tech\
		[ForecastYear]=1 , -1 , 
	IF THEN ELSE(Power Allocation[ForecastYear]=1:AND:Energy Availability Allocation by Size Tech\
		[ForecastYear]=0,1,
	IF THEN ELSE(Power Allocation[ForecastYear]=1:AND:Energy Availability Allocation by Size Tech\
		[ForecastYear]=1,2,0) ) ))
	~	Dmnl
	~		|

Selected Profitable Technologies[ZTech]=
	IF THEN ELSE(EXP(Profitable Power Technologies[ZTech]/1e+08)=1, 0 , EXP(Profitable Power Technologies\
		[ZTech]/1e+08))
	~	Dmnl
	~		|

Nonprofitable Power Technologies[ZTech]=
	IF THEN ELSE(Mean Availability Factor Hour of Max Need[f0,ZTech]<=0.1, 0 ,
	IF THEN ELSE(Negative NPV Tecnologies[ZTech]=0, 0 , (Negative NPV Tecnologies[ZTech]\
		-vmin(Negative NPV Tecnologies[ZTech
	!])) ))
	~	USD
	~	EXP(
		LOG(1+Positive NPV Technologies[ZTech], EXP(1) )
		)
		/Sum(EXP(LOG(1+Positive NPV Technologies[ZTech], EXP(1) )))
	|

NPV Indicator Adjusted[ZTech]=
	NPV Indicator Only RES[ZTech]+NPV Indicator With Thermal[ZTech]
	~	MW
	~		|

Profitable Power Technologies[ZTech]=
	IF THEN ELSE(Mean Availability Factor Hour of Max Need[f0,ZTech]<=0.1,0 , Profitable Technologies\
		[ZTech] )
	~	USD
	~	IF THEN ELSE(Mean Availability Factor Hour of Max Need[f0,ZTech]=0,0 , \
		Profitable Technologies[ZTech] )
	|

NPV Indicator With Thermal[ZTech]=
	IF THEN ELSE(Switch Only RES Investment=0, NPV Indicator by Tech[ZTech], 0 )
	~	USD
	~		|

Economic Power Generation Capacity Factor[ZTech]=
	IF THEN ELSE(Sum(Profitable Power Technologies[ZTech!])=0,
	IF THEN ELSE(Sum(Selected Nonprofitable Technologies[ZTech!])=0, 0 ,Selected Nonprofitable Technologies\
		[ZTech]/Sum(Selected Nonprofitable Technologies[ZTech!])),
	IF THEN ELSE(Sum(Selected Profitable Technologies[ZTech!])=0,0,Selected Profitable Technologies\
		[ZTech]/Sum(Selected Profitable Technologies[ZTech!])))
	~	Dmnl
	~		|

Negative NPV Tecnologies[ZTech]=
	IF THEN ELSE(NPV Indicator Adjusted[ZTech]<0, NPV Indicator Adjusted[ZTech] , 0 )
	~	USD
	~		|

Positive NPV Technologies[ZTech]=
	IF THEN ELSE(NPV Indicator Adjusted[ZTech]<=0, 0 , NPV Indicator Adjusted[ZTech])
	~	USD
	~		|

Selected Nonprofitable Technologies[ZTech]=
	IF THEN ELSE(Nonprofitable Power Technologies[ZTech]=0,0,IF THEN ELSE( 
	EXP((
	(Nonprofitable Power Technologies[ZTech]-VMAX(Nonprofitable Power Technologies[ZTech\
		!]))
	)/1e+08)<0.05,0,EXP((
	(Nonprofitable Power Technologies[ZTech]-VMAX(Nonprofitable Power Technologies[ZTech\
		!]))
	)/1e+08)))
	~	Dmnl
	~		|

Switch Only RES Investment=
	GET XLS CONSTANTS('?Datos', 'General Parameters', 'B18')
	~	Dmnl
	~		|

Available GET Capacity[Int]= INTEG (
	New GET Availability[Int]-GET Used for Congestion[Int],
		Initial Interconnection Capacity[Int]*Switch GETs*Allowed GET Percentage[Int])
	~	MW
	~		|

GET Capacity in progress[Int]= DELAY MATERIAL (
	 IF THEN ELSE(Expansion Plan Delay TI[GETs]=0,
	GET Used for Congestion[Int],
	 IF THEN ELSE(MODULO(Time,Expansion Plan Delay TI[GETs])=0 , 
	Expansion Plan Development IC[Int,GETs]/TIME STEP, 
	 0 )) , Accumulated Transmission for Interconnection delays[GETs]-Expansion Plan Delay TI\
		[GETs]*2 -5, 0 , 0)
	~	MW
	~		|

GET Used for Congestion[Int]=
	Grid Technology Need[Int,GETs]/TIME STEP
	~	MW
	~		|

Total GET Capacity Used[Int]= INTEG (
	GET Capacity in progress[Int],
		0)
	~	MW
	~		|

Allowed GET Percentage[Int]=
	GET XLS CONSTANTS('?Datos','Interconnections','S3*' )
	~	Dmnl
	~		|

Max Allowed GET Capacity[Int]=
	(Interconnection Capacity[Int]-Total GET Capacity Used[Int])*Allowed GET Percentage[\
		Int]
	~	MW
	~	IF THEN ELSE(Interconnection Capacity[Int]=0,0,
		IF THEN ELSE(Total GET used[Int]/Interconnection \
		Capacity[Int]>0.3,0,Interconnection Capacity[Int]*0.3))
	|

GET Capacity Delayed[Int]= DELAY MATERIAL (
	Max Allowed GET Capacity[Int], 1 ,0, 0)
	~	MW
	~		|

Total GETs Capacity=
	Sum(Total GET Capacity Used[Int!])
	~	MW
	~		|

Interconnection GETs Ratio[Int]=
	IF THEN ELSE(Interconnection Capacity[Int]=0, 0 , Total GET Capacity Used[Int]/Interconnection Capacity\
		[Int] )
	~	Dmnl
	~		|

Zones to Expand Interconnection Congested[Int]=
	IF THEN ELSE(Accumulated Transmission for Interconnection delays[Lines]=0 ,Additional Grid Need for Congestion\
		[f0,Int]  
	, Additional Grid Need for Congestion[f7,Int] )*IF THEN ELSE(Switch Dispatch=1:OR:Switch Dispatch\
		=0, 1 , 0 )
	+Interconnection Capacity to Install*IF THEN ELSE(Switch Dispatch=-1, 1 , 0 )
	~	MW/Month
	~		|

Available Interconnection Flow by Int[ForecastYear,Hour,Int1]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z2]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z1]>0,Min(Min Interconnection Capacity
	[ForecastYear,Int1],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int1],Interconnection Surplus Value[ForecastYear,Hour,Int1])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int2]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z1]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z3]>0,Min(Min Interconnection Capacity
[ForecastYear,Int2],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int2],Interconnection Surplus Value[ForecastYear,Hour,Int2])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int3]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z1]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z4]>0,Min(Min Interconnection Capacity
[ForecastYear,Int3],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int3],Interconnection Surplus Value[ForecastYear,Hour,Int3])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int4]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z1]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z5]>0,Min(Min Interconnection Capacity
[ForecastYear,Int4],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int4],Interconnection Surplus Value[ForecastYear,Hour,Int4])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int5]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z1]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z6]>0,Min(Min Interconnection Capacity
[ForecastYear,Int5],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int5],Interconnection Surplus Value[ForecastYear,Hour,Int5])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int6]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z2]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z3]>0,Min(Min Interconnection Capacity
[ForecastYear,Int6],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int6],Interconnection Surplus Value[ForecastYear,Hour,Int6])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int7]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z2]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z4]>0,Min(Min Interconnection Capacity
[ForecastYear,Int7],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int7],Interconnection Surplus Value[ForecastYear,Hour,Int7])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int8]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z2]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z5]>0,Min(Min Interconnection Capacity
[ForecastYear,Int8],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int8],Interconnection Surplus Value[ForecastYear,Hour,Int8])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int9]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z2]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z6]>0,Min(Min Interconnection Capacity
[ForecastYear,Int9],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int9],Interconnection Surplus Value[ForecastYear,Hour,Int9])),0) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int10]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z4]>0,Min(Min Interconnection Capacity
[ForecastYear,Int10],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int10],Interconnection Surplus Value[ForecastYear,Hour,Int10])),0\
		) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int11]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z5]>0,Min(Min Interconnection Capacity
[ForecastYear,Int11],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int11],Interconnection Surplus Value[ForecastYear,Hour,Int11])),0\
		) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int12]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z3]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z6]>0,Min(Min Interconnection Capacity
[ForecastYear,Int12],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int12],Interconnection Surplus Value[ForecastYear,Hour,Int12])),0\
		) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int13]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z5]>0,Min(Min Interconnection Capacity
[ForecastYear,Int13],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int13],Interconnection Surplus Value[ForecastYear,Hour,Int13])),0\
		) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int14]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z4]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z6]>0,Min(Min Interconnection Capacity
[ForecastYear,Int14],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int14],Interconnection Surplus Value[ForecastYear,Hour,Int14])),0\
		) ~~|
Available Interconnection Flow by Int[ForecastYear,Hour,Int15]=
	IF THEN ELSE(Surplus by Zone[ForecastYear,Hour,Z5]>0:OR:Surplus by Zone[ForecastYear\
		,Hour,Z6]>0,Min(Min Interconnection Capacity
[ForecastYear,Int15],Min(Interconnection Deficit Value
	[ForecastYear,Hour,Int15],Interconnection Surplus Value[ForecastYear,Hour,Int15])),0\
		)
	~	MW
	~		|

Selected Line to Expand[ForecastYear]=
	IF THEN ELSE(
	Total Indirect Indicator[ForecastYear]=Min(Total Indirect Indicator[ForecastYear]
	,Total Direct Indicator[ForecastYear]),1,0)
	~	MW*km
	~	IF THEN ELSE(
		Sum(Indirect Line to Expand Indicator[ForecastYear,Int!])= 
		Min(IF THEN ELSE(Direct Interconnection Condition[ForecastYear,Int]=1,Sum(Direct \
		Line to Expand Indicator[ForecastYear,Int!]),0),
		IF THEN ELSE(Indirect Interconnection \
		Condition[ForecastYear,Int]=1,Sum(Indirect Line to Expand \
		Indicator[ForecastYear,Int!]),0)), 1, 0 )
	|

Generation Factor Congested[ForecastYear,Hour,ZTech]=
	IF THEN ELSE( Congested Dispatch Vensim[ForecastYear,Hour,ZTech]=0, 0, 
	Congested Dispatch Vensim[ForecastYear,Hour,ZTech]/Expected Generation Capacity[ForecastYear\
		,ZTech])
	~	Dmnl
	~		|

Congested Dispatch Vensim[ForecastYear,Hour,Z1Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z1Tech], 
	Dispatch Priority[Z1Tech], 
	ELMCOUNT(Z1Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z1]) ~~|
Congested Dispatch Vensim[ForecastYear,Hour,Z2Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z2Tech], 
	Dispatch Priority[Z2Tech], 
	ELMCOUNT(Z2Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z2]) ~~|
Congested Dispatch Vensim[ForecastYear,Hour,Z3Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z3Tech], 
	Dispatch Priority[Z3Tech], 
	ELMCOUNT(Z3Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z3]) ~~|
Congested Dispatch Vensim[ForecastYear,Hour,Z4Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z4Tech], 
	Dispatch Priority[Z4Tech], 
	ELMCOUNT(Z4Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z4]) ~~|
Congested Dispatch Vensim[ForecastYear,Hour,Z5Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z5Tech], 
	Dispatch Priority[Z5Tech], 
	ELMCOUNT(Z5Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z5]) ~~|
Congested Dispatch Vensim[ForecastYear,Hour,Z6Tech]=
	ALLOCATE BY PRIORITY(
	Available Generation[ForecastYear,Hour,Z6Tech], 
	Dispatch Priority[Z6Tech], 
	ELMCOUNT(Z6Tech),
	Width, 
	Residual Demand with Imbalances[ForecastYear,Hour,Z6])
	~	MWh
	~		|

Congested Zone Prices[ForecastYear,Hour,Z1]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z1Tech!]) ~~|
Congested Zone Prices[ForecastYear,Hour,Z2]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z2Tech!]) ~~|
Congested Zone Prices[ForecastYear,Hour,Z3]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z3Tech!]) ~~|
Congested Zone Prices[ForecastYear,Hour,Z4]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z4Tech!]) ~~|
Congested Zone Prices[ForecastYear,Hour,Z5]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z5Tech!]) ~~|
Congested Zone Prices[ForecastYear,Hour,Z6]=
	VMAX(Adjusted Offer Price Congested Dispatch[ForecastYear,Hour,Z6Tech!])
	~	USD/MWh
	~		|

Total Indirect Indicator[ForecastYear]=
	Sum(Indirect Line to Expand Indicator[ForecastYear,Int!])
	~	MW*km
	~		|

Total Interconnection Capacity Need[ForecastYear,Int]=
	(Direct Interconnection Deficit Value[ForecastYear,Int])*(1-Selected Line to Expand[\
		ForecastYear])+
	(Indirect Interconnection Deficit Value[ForecastYear,Int])*Selected Line to Expand[ForecastYear\
		]
	~	
	~		|

Total Direct Indicator[ForecastYear]=
	Sum(Direct Line to Expand Indicator[ForecastYear,Int!])
	~	MW*km
	~		|

Indirect Interconnection Deficit Value[ForecastYear,Int]=
	(vmin(Interconnection Route Segment 1 Value[ForecastYear,Hour!,Int])+vmin(Interconnection Route Segment 2 Value\
		[ForecastYear,Hour!,Int]))*-1
	~	MW
	~		|

Indirect Line to Expand Indicator[ForecastYear,Int]=
	Indirect Interconnection Deficit Value[ForecastYear,Int]*Mean Length by Int[Int]
	~	MW*km
	~		|

Extra Interconnection Capacity Need[ForecastYear,Hour,Int]=
	Min Interconnection Capacity[ForecastYear,Int]
	-VMAX(Interconnection Flow[ForecastYear,Hour,Int,Zone!])
	-VMAX(Second Interconnection Flow[ForecastYear,Hour,Int,Zone!])
	-VMAX(Third Interconnection Flow[ForecastYear,Hour,Int,Zone!])
	~	MW
	~		|

Direct Line to Expand Indicator[ForecastYear,Int]=
	Mean Length by Int[Int]*Direct Interconnection Deficit Value[ForecastYear,Int]
	~	MW*km
	~		|

Direct Interconnection Deficit Value[ForecastYear,Int]=
	VMAX(Net Interconection Capacity Expansion[ForecastYear,Hour!,Int])
	~	MW
	~		|

Interconnection Route Segment 2 Value[ForecastYear,Hour,Int1]=
