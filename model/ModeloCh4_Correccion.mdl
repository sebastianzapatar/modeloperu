Net Interconection Capacity Expansion[ForecastYear,Hour,Int]=
	IF THEN ELSE(
	Extra Interconnection Capacity Need[ForecastYear,Hour,Int]>0,0,
	Extra Interconnection Capacity Need[ForecastYear
	,Hour,Int])*-1+vmin(Third Interconnection Adjusted Imbalance[ForecastYear,Hour,Int,Zone\
		!])*-1
	~	MW
	~	IF THEN ELSE(
		Extra Direct Interconnection Capacity Need[ForecastYear,Hour,Int]>0,0,
		Extra Direct Interconnection Capacity Need[ForecastYear
		,Hour,Int])*-1+vmin(Third Interconnection Adjusted \
		Imbalance[ForecastYear,Hour,Int])*-1
	|

